DJANGO_SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Next.js frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Termii — confirm TERMII_BASE_URL against your dashboard/docs, it has
# changed before (api.termii.com vs api.ng.termii.com by region).
TERMII_API_KEY=your-termii-api-key
TERMII_BASE_URL=https://api.ng.termii.com

# Flutterwave — use test keys (FLWSECK_TEST-... / FLWPUBK_TEST-...) while developing
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Same value you set as the webhook "secret hash" in the Flutterwave dashboard
FLUTTERWAVE_WEBHOOK_HASH=change-me

# Sendchamp — shared/instant sender IDs, managed from the admin console now
SENDCHAMP_API_KEY=your-sendchamp-api-key
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1

# KudiSMS — same idea as Sendchamp
KUDISMS_API_KEY=your-kudisms-api-key
KUDISMS_BASE_URL=https://my.kudisms.net

# Shared secret an external scheduler presents (as "Bearer <this>") when
# calling POST /api/cron/process-campaigns/ every ~minute, to advance any
# large campaign still queued. Not Vercel's own Cron — Hobby caps that at
# once/day. A cron-job.org or GitHub Actions scheduled workflow works fine.
CRON_SECRET=change-me-to-a-long-random-value
